# ---------------------------------------------------------------------------
# Copy file này thành .env rồi điền thông tin thật:  copy .env.example .env
# File .env KHÔNG được commit (đã nằm trong .gitignore).
# ---------------------------------------------------------------------------

# --- Profile A: PostgreSQL cài trực tiếp trên máy (mặc định) ---------------
DATABASE_URL=postgresql://postgres:<MAT_KHAU_POSTGRES_CUA_BAN>@localhost:5432/music_rights_ai

# --- Profile B: PostgreSQL chạy bằng Docker Compose ------------------------
# Bỏ comment dòng dưới và comment dòng Profile A ở trên.
# Cổng 5433 để không đụng với PostgreSQL đã cài sẵn trên máy.
# DATABASE_URL=postgresql://postgres:<MAT_KHAU_POSTGRES_CUA_BAN>@localhost:5433/music_rights_ai

# Mật khẩu cho container postgres của docker-compose — BẮT BUỘC, compose dừng nếu
# thiếu. Phải trùng mật khẩu trong DATABASE_URL (Profile B).
POSTGRES_PASSWORD=<MAT_KHAU_POSTGRES_CUA_BAN>
POSTGRES_HOST_PORT=5433
# Cổng API trên máy host khi chạy backend bằng docker compose
API_HOST_PORT=8000

# --- Đường dẫn dữ liệu (tương đối so với thư mục gốc project) -------------
DATA_DIR=data/processed
FAISS_INDEX_PATH=data/processed/mert_faiss.index
FAISS_ID_MAP_PATH=data/processed/faiss_id_map.json
EMBEDDINGS_CSV=data/processed/embeddings_master.csv
METADATA_CSV=data/processed/metadata_master.csv
TEMP_UPLOAD_DIR=temp_uploads
# Thư mục chứa audio thật của corpus tham chiếu (vài chục GB, KHÔNG nằm trong git).
# Trỏ sang ổ khác nếu ổ hệ thống chật. docker compose mount chính thư mục này vào
# container (chỉ đọc) nên nên dùng đường dẫn tuyệt đối:
# AUDIO_ROOT=D:/music-rights-data/audio
AUDIO_ROOT=data/raw

# --- Ngưỡng nhận diện -----------------------------------------------------
# Hiệu chỉnh trên corpus FMA medium thật: 24.375 bản ghi có fingerprint và
# descriptor cover, 48.750 vector embedding, 1.900 truy vấn biến đổi. Bảng quét
# ngưỡng đầy đủ và lý do chọn: xem backend/config.py. Không đặt các khoá này thì
# dùng đúng giá trị mặc định trong backend/config.py.
#
# PHẢI đổi CÙNG LÚC với min_identity_confidence_by_match_type trong
# configs/rules_v1.yaml (EXACT_MATCH = τFP, NEAR_MATCH = τMERT, COVER_MATCH =
# τCover). Lệch nhau thì cascade nhận một khớp rồi Rule Engine vứt chính khớp đó
# thành UNKNOWN. scripts/run_all_experiments.py kiểm tra điều này.

# FP_THRESHOLD = 0.30 — EXP-01: Precision 0.9981, FPR held-out 0.0 trên 1.900 truy vấn
#   (quy tắc bên dưới nay ra 0.10; chủ dự án giữ 0.30 — lý do trong backend/config.py).
#   Tiêu chí chọn: F1 cao nhất trong nhóm giữ FPR <= 0.005.
FP_THRESHOLD=0.30
# Lọc sơ bộ theo độ dài trước khi so khớp fingerprint (giây); 0 = tắt
FP_DURATION_WINDOW_S=0
# Dải dò lệch khi so khớp fingerprint (item, ~0.124s/item); 0 = dò toàn bộ
FP_MAX_ALIGN_OFFSET=0
# Lọc ứng viên Tầng 1 theo hash trùng: chấm đầy đủ TOP_K bản ghi, quay về quét
# toàn bộ khi điểm trong ±BAND quanh ngưỡng hoặc truy vấn ngắn hơn MIN_QUERY_S.
# TOP_K=0 -> luôn quét toàn bộ (~4,5 s/truy vấn ở 24.375 fingerprint).
FP_PREFILTER_TOP_K=50
FP_PREFILTER_BAND=0.15
FP_PREFILTER_MIN_QUERY_S=10
# MERT_THRESHOLD = 0.98 — EXP-06: False Match Rate 2.65% trên 48.750 vector.
#   Ở 0.97 thì FMR 6.12% — vượt trần 5%.
MERT_THRESHOLD=0.98
# COVER_THRESHOLD — EXP-07 đo đúng điều kiện server trên chỉ mục 24.375 bài.
#   Xem giá trị hiện hành và lý do trong backend/config.py.
COVER_THRESHOLD=0.90
COVER_ENABLED=true
# Hệ số nhịp độ tầng Cover thử khi cắt truy vấn (reference = 30 s đầu ở nhịp gốc).
#   Đặt 1.0 để chỉ cắt đúng 30 giây đầu như bản cũ.
COVER_TEMPO_FACTORS=0.90,0.95,1.00,1.05,1.10
TOP_K=5

# --- Model ----------------------------------------------------------------
MERT_MODEL=m-a-p/MERT-v1-95M
MERT_MODEL_VERSION=MERT-v1-95M
# Commit Hugging Face đã dùng để dựng chỉ mục. MERT chạy trust_remote_code nên
# ghim cả trọng số lẫn mã; để trống = bản mới nhất (embedding có thể lệch chỉ mục).
MERT_MODEL_REVISION=12af15fef9d0ac838c3f475bfbbf26d2060dd4f5
# Thiết bị chạy MERT: auto | cpu | cuda
DEVICE=auto
# Làm nóng lúc khởi động (luồng nền): giải mã fingerprint tham chiếu, nạp MERT, nạp
# chỉ mục Cover. Tắt thì truy vấn đầu tiên sau mỗi lần bật server chậm thêm ~25 s.
WARMUP_ON_STARTUP=true
MERT_SAMPLE_RATE=24000
MERT_MAX_DURATION=30.0
EMBEDDING_DIM=768

# --- Upload ---------------------------------------------------------------
MAX_UPLOAD_MB=100

# --- Nguồn corpus ---------------------------------------------------------
# Jamendo cho phép lọc theo từng loại giấy phép CC ngay ở tầng truy vấn, nên đây
# là cách chủ động lấp nhóm mà FMA còn ít. Đăng ký miễn phí: devportal.jamendo.com
# JAMENDO_CLIENT_ID=
